@page "/verifications"
@using SoftwareVerification.Domain.Dto
@inject VerificationApiClient VerificationApi
@inject NotificationClientService NotificationSvc
@inject IHttpClientFactory HttpClientFactory
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<h3 class="mt-4">Список объектов верификации</h3>

@if (loading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Загрузка...</span>
    </div>
}
else if (objects == null || !objects.Any())
{
    <div class="alert alert-info">Список пуст или произошла ошибка при загрузке.</div>
}
else
{
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Добавить новый объект</h5>
            <EditForm Model="@newObject" OnValidSubmit="HandleCreate" FormName="createVerificationForm">
                <DataAnnotationsValidator />
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label>Имя</label>
                        <InputText @bind-Value="newObject.Name" class="form-control" />
                    </div>
                    <div class="col-md-3 mb-2">
                        <label>Версия</label>
                        <InputText @bind-Value="newObject.Version" class="form-control" />
                    </div>
                    <div class="col-md-2 mb-2">
                        <label>Тип</label>
                        <InputSelect @bind-Value="newObject.Type" class="form-select">
                            <option value="Software">Software</option>
                            <option value="HardwareSoftwareComplex">HardwareSoftwareComplex</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-3 mb-2">
                        <label>Дата получения</label>
                        <input type="datetime-local" @bind="newObject.ReceivedAt" class="form-control" />
                    </div>
                    <div class="col-md-5 mb-2">
                        <label>Комментарий эксперта</label>
                        <InputText @bind-Value="newObject.ExpertComment" class="form-control" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100" disabled="@isSaving">
                            @(isSaving ? "Сохранение..." : "Сохранить")
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Имя</th>
                <th>Версия</th>
                <th>Тип</th>
                <th>Статус</th>
                <th>Дата получения</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in objects)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Version</td>
                    <td>@item.Type</td>
                    <td>
                        <span class="badge @(item.Result == "Success" ? "bg-success" : "bg-danger")">
                            @item.Result
                        </span>
                    </td>
                    <td>@item.ReceivedAt.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // ⚠️ Локальные переменные вместо Scoped-сервиса
    private List<VerificationObjectDto>? objects;
    private CreateVerificationObjectDto newObject = new();
    private bool loading = true;
    private bool isSaving = false;
    private bool _hubStarted = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hubStarted)
        {
            _hubStarted = true;
            await NotificationSvc.StartAsync();
        }
    }

    private async Task LoadData()
    {
        loading = true;
        var client = HttpClientFactory.CreateClient("ApiClient");
        try
        {
            objects = await client.GetFromJsonAsync<List<VerificationObjectDto>>("/api/verification-objects");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task HandleCreate()
    {
        isSaving = true;

        // 1. Сохраняем
        var success = await VerificationApi.CreateAsync(newObject);

        if (success)
        {
            // 2. Отправляем уведомление (пока колокольчик точно жив)
            var message = $"создан новый объект: {newObject.Name}";
            await NotificationSvc.SendNotificationAsync(message);

            // 3. Очищаем форму
            newObject = new();

            // 4. Перезагружаем ТОЛЬКО локальный список
            await LoadData();

            // Layout не трогаем, он не пересоздастся
        }

        isSaving = false;
    }
}