@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <AuthorizeView Roles="User">
            <Authorized>
                <NavLink class="nav-link-custom" href="" Match="NavLinkMatch.All">Главная страница</NavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin">
            <Authorized>
              <NavLink class="nav-link-custom" href="verifications">Верификация ПО</NavLink>
            </Authorized>
        </AuthorizeView>
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center gap-3">
            <AuthorizeView>
                <Authorized>
                    <a href="/api/auth/logout" class="btn btn-link text-danger">Выйти</a>
                </Authorized>
            </AuthorizeView>
        </div>
        <article class="content px-4">
            @Body
            <!-- Контейнер для Toast-уведомлений -->
            <div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3"></div>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <NavLink href="." class="reload">Reload</NavLink>
    <span class="dismiss">🗙</span>
</div>
